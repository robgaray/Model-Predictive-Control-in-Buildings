# -------------------------------------------------------------
# Function: save_optim_params
# Part of the Model Predictive Control in buildings repository
# https://github.com/robgaray/Model-Predictive-Control-in-Buildings
# Developed by Roberto Garay Martinez
# -------------------------------------------------------------
# Saves the Optim_parameters.csv and scc_settings.sh files to
# the 02_SCC simulation directory.
#
# Both files are written in binary mode with LF line endings so
# the generated files are compatible with Linux even when this
# function is run on Windows.
# -------------------------------------------------------------
# Inputs
#   df             : data.frame of configurations to save
#   scc_path       : path to the 02_SCC simulation directory
#   tasks_per_job  : integer, number of tasks (configurations)
#                    per Slurm job array submission
#   scc_queue      : character, Slurm partition name
#   scc_qos        : character, Slurm Quality of Service name
#   scc_user       : character, user email for --mail-user
#   scc_username   : character, cluster login username for squeue
#   output_formats : character vector, subset of
#                    c("main_csv","main_rds","synth_csv","synth_rds")
#   job_name       : character, Slurm job name for identification
# -------------------------------------------------------------
# Outputs
#   Invisible list with csv_path and sh_path of written files.
# -------------------------------------------------------------
# Code outline
#   1. Sanitize inputs
#   2. Write Optim_parameters.csv
#   3. Write scc_settings.sh
# -------------------------------------------------------------
# Usage instructions
#   save_optim_params(df, scc_path, tasks_per_job = 100,
#                     job_name = "MPC_optim")
# -------------------------------------------------------------
# Where this function/script is used
#   Called by GUI_parametric.R when the user clicks
#   "Generate Configuration File".
# -------------------------------------------------------------
# functions/scripts called
#   None (base R only).
# -------------------------------------------------------------
save_optim_params <- function(df, scc_path, tasks_per_job,
                              scc_queue = "general", scc_qos = "serial",
                              scc_user = "",
                              scc_username = "",
                              output_formats = c("main_csv", "main_rds",
                                                 "synth_csv", "synth_rds"),
                              job_name = "MPC_optim") {

  # -------------------------------------------------------------
  # 1. Sanitize inputs to prevent shell injection
  # -------------------------------------------------------------
  {
    scc_queue      <- gsub('[^A-Za-z0-9_-]', '', scc_queue)
    scc_qos        <- gsub('[^A-Za-z0-9_-]', '', scc_qos)
    scc_user       <- gsub('[^A-Za-z0-9_.@-]', '', scc_user)
    scc_username   <- gsub('[^A-Za-z0-9_.-]', '', scc_username)
    job_name       <- gsub('[^A-Za-z0-9_.-]', '', job_name)
    if (!nzchar(job_name)) job_name <- "MPC_optim"
    output_formats <- intersect(output_formats,
                               c("main_csv", "main_rds",
                                 "synth_csv", "synth_rds"))
  }

  # -------------------------------------------------------------
  # 2. Write Optim_parameters.csv with LF line endings
  # -------------------------------------------------------------
  {
    csv_path <- file.path(scc_path, "Optim_parameters.csv")
    tc <- textConnection("csv_lines", "w")
    write.csv(df, tc, row.names = FALSE, quote = FALSE)
    close(tc)
    con <- file(csv_path, open = "wb")
    writeLines(csv_lines, con, sep = "\n")
    close(con)
  }

  # -------------------------------------------------------------
  # 3. Write scc_settings.sh with cluster settings
  # -------------------------------------------------------------
  {
    sh_path  <- file.path(scc_path, "scc_settings.sh")
    sh_lines <- c(
      "#!/bin/bash",
      "# -------------------------------------------------------------",
      "# scc_settings.sh",
      "# SCC cluster settings for parametric MPC simulations.",
      paste0("# Generated by: 40_GUI/02_Configure_Parametric_Simulations/",
             "GUI_parametric.R"),
      "# Do not edit manually - use the GUI to regenerate.",
      "# -------------------------------------------------------------",
      "",
      "# Number of tasks (configurations) per Slurm job array.",
      "# Most clusters impose a limit on array size (e.g. 1000).",
      "# Adjust this value to match your cluster's limit.",
      paste0("TASKS_PER_JOB=", as.integer(tasks_per_job)),
      "",
      "# Slurm job name for identification in squeue.",
      paste0('JOB_NAME="', job_name, '"'),
      "",
      "# Slurm partition (queue) for job submission.",
      paste0('SCC_QUEUE="', scc_queue, '"'),
      "",
      "# Slurm Quality of Service (qos) for job submission.",
      paste0('SCC_QOS="', scc_qos, '"'),
      "",
      "# User email for Slurm --mail-user notifications.",
      paste0('SCC_USER="', scc_user, '"'),
      "",
      "# Cluster login username for squeue monitoring.",
      paste0('SCC_USERNAME="', scc_username, '"'),
      "",
      "# Output file formats: individual flags for Main_df and",
      "# Sinthetized_df_computed in CSV and/or RDS format.",
      paste0('SCC_OUTPUT_FORMATS="',
             paste(output_formats, collapse = ","), '"')
    )
    con <- file(sh_path, open = "wb")
    writeLines(sh_lines, con, sep = "\n")
    close(con)
  }

  invisible(list(csv_path = csv_path, sh_path = sh_path))
}
